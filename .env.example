# Copy to .env and edit. Every value here has a working default.

ANCHOR_DATABASE_URL=postgresql://postgres:anchor@localhost:5432/anchor

# Lease length. Recovery after a hard kill takes roughly this long, because that
# is how long it takes the dead worker's lease to expire. Shorter means faster
# recovery and more heartbeat traffic.
ANCHOR_LEASE_SECONDS=30
ANCHOR_HEARTBEAT_SECONDS=5
ANCHOR_POLL_INTERVAL=0.25

# In-attempt retries for transient step failures.
ANCHOR_STEP_MAX_ATTEMPTS=3
ANCHOR_STEP_BACKOFF_BASE=0.2

ANCHOR_WORKER_CONCURRENCY=4

# echo = deterministic offline provider (default, no credentials needed)
# anthropic = real model
ANCHOR_MODEL_PROVIDER=echo
ANCHOR_ECHO_PLAN=lookup_payment,issue_refund,notify_customer

# ANTHROPIC_API_KEY=sk-ant-...
# ANCHOR_ANTHROPIC_MODEL=claude-sonnet-5

# Set these from current published pricing if you want cost budgets to mean
# anything. Left unset, cost stays zero and token budgets still work.
# ANCHOR_PRICE_IN_PER_MTOK=
# ANCHOR_PRICE_OUT_PER_MTOK=

# ── AWS backend (optional) ────────────────────────────────────────────────────
# ANCHOR_BACKEND=dynamo   (default: postgres)
# ANCHOR_DYNAMO_TABLE=anchor
# ANCHOR_DYNAMO_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/anchor-queue
# ANCHOR_DYNAMO_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
